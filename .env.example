# Copy this file to ".env" (same folder as main.py). Everything here is OPTIONAL.
APP_URL=http://localhost:8000
TOKEN_DAYS=7
MAX_UPLOAD_MB=50

# Invitation emails (optional). Gmail example: enable 2-step verification, then create an "App password".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=yourname@gmail.com

# PDF export with Hindi: path of a Unicode TTF font (Windows auto-detects Nirmala.ttf)
# FONT_PATH=C:\Windows\Fonts\Nirmala.ttf

# Docker + HTTPS only
# DOMAIN=docs.yourcompany.com
